# =========================================================
# Supabase & Database Configuration
# =========================================================
# Paste your Supabase PostgreSQL connection URI:
SUPABASE_DB_URL=

# Alternatively, set to 'mysql' or 'sqlite' or 'auto'
DATABASE_TYPE=auto
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=gym_management

# SQLite fallback path
SQLITE_DB_PATH=gym_management.db

# =========================================================
# Allowed Login Credentials (Only these can log in)
# =========================================================
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
ADMIN_FULL_NAME=Malik Tariq (Owner)

# App Security
SECRET_KEY=pakistani_gym_management_super_secret_key_2026
DEBUG=True

