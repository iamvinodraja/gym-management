# Or pooler: postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres
SUPABASE_DB_URL=postgresql://postgres.hhwdtcmcotqmieigmdxx:Passwardhacked123@aws-0-ap-northeast-1.pooler.supabase.com:6543/postgres

# Alternatively, set to 'mysql' or 'sqlite' or 'auto'
